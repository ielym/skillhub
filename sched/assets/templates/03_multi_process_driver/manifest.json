{
  "schema_version": 3,
  "name": "arxiv_driver",
  "description": "驱动进程：每天写一个新意图（抓当天论文），再加一个 2 天大任务意图",
  "run_mode": "auto",
  "entry": { "file": "controller.py", "interpreter": "python3", "args": [], "cwd": "." },
  "priority": 50,
  "resources": { "cpu": 0.1, "memory_mb": 64 },
  "error_rules": { "resource_regex": [], "logic_regex": [] },
  "heartbeat": { "timeout_sec": 120 },
  "runtime": { "user": "sched-run" }
}
