{
  "schema_version": 2,
  "name": "report-on-demand",
  "description": "场景模板03：手动按需触发的大结果集导出（manual 但仍可断点续跑；run 入队，受同一套抢占/心跳约束，心跳阈值自动×2）。复制后改名。",
  "entry": {
    "file": "run.py",
    "interpreter": "python3",
    "args": [],
    "cwd": "."
  },
  "schedule": {
    "type": "manual",
    "max_instances": 1,
    "overflow": "queue"
  },
  "priority": 55,
  "env": {},
  "outputs": {
    "expect": [
      "results/export.csv"
    ]
  },
  "resources": {
    "cpu": 0.4,
    "memory_mb": 192
  },
  "error_rules": {
    "resource_regex": [
      "timeout",
      "connection",
      "quota",
      "temporarily"
    ],
    "logic_regex": [
      "LOGIC:"
    ]
  },
  "heartbeat": {
    "timeout_sec": 180
  },
  "smoke": {
    "mode": "dry",
    "max_runtime_sec": 60,
    "signal_after_sec": 1.5
  },
  "runtime": {
    "user": "sched-run"
  },
  "contract_exempt": false
}
