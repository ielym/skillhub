{
  "schema_version": 2,
  "name": "atomic-cutover",
  "description": "场景模板04：无法断点/不可中途重入的原子运维动作（contract_exempt=true，强制 manual，不可抢占；崩溃后需人工确认，不自动恢复）。仅用于真正无法保证数据完整性的场景，能断点的任务禁止用它逃避抢占。",
  "entry": {
    "file": "run.py",
    "interpreter": "python3",
    "args": [],
    "cwd": "."
  },
  "schedule": {
    "type": "manual",
    "max_instances": 1,
    "overflow": "skip"
  },
  "priority": 90,
  "env": {},
  "outputs": {
    "expect": [
      "results/cutover.json"
    ]
  },
  "resources": {
    "cpu": 0.2,
    "memory_mb": 96
  },
  "error_rules": {
    "resource_regex": [
      "timeout",
      "connection",
      "temporarily"
    ],
    "logic_regex": [
      "LOGIC:"
    ]
  },
  "heartbeat": {
    "timeout_sec": 300
  },
  "smoke": {
    "mode": "dry",
    "max_runtime_sec": 60
  },
  "runtime": {
    "user": "sched-run"
  },
  "contract_exempt": true
}
