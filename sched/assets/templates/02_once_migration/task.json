{
  "schema_version": 2,
  "name": "backfill-once",
  "description": "场景模板02：一次性数据迁移/历史回填（once 定点触发、高优先级、按 ID 分片断点、逻辑错误显式转人工）。复制后改名为你的任务 id，once_at 必须是未来时刻。",
  "entry": {
    "file": "run.py",
    "interpreter": "python3",
    "args": [],
    "cwd": "."
  },
  "schedule": {
    "type": "once",
    "once_at": "2026-10-04T02:00:00+08:00"
  },
  "priority": 80,
  "env": {},
  "outputs": {
    "expect": [
      "results/backfill_summary.json"
    ]
  },
  "resources": {
    "cpu": 0.5,
    "memory_mb": 256
  },
  "error_rules": {
    "resource_regex": [
      "timeout",
      "connection",
      "deadlock",
      "lock wait",
      "temporarily"
    ],
    "logic_regex": [
      "LOGIC:"
    ]
  },
  "heartbeat": {
    "timeout_sec": 120
  },
  "smoke": {
    "mode": "dry",
    "max_runtime_sec": 60,
    "signal_after_sec": 1.5
  },
  "runtime": {
    "user": "sched-run"
  },
  "contract_exempt": false
}
