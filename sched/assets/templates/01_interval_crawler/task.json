{
  "schema_version": 2,
  "name": "crawler-hourly",
  "description": "场景模板01：工作时间窗内定时采集（分页游标断点/代理软资源/坏页 skip→110 二刷/资源错误快速 101）。复制后改名为你的任务 id。",
  "entry": {
    "file": "run.py",
    "interpreter": "python3",
    "args": [],
    "cwd": "."
  },
  "schedule": {
    "type": "interval",
    "interval": 1800,
    "start_time": "08:30",
    "end_time": "20:00",
    "weekdays": [1, 2, 3, 4, 5, 6],
    "allow_overrun": false,
    "max_instances": 1,
    "overflow": "skip"
  },
  "priority": 45,
  "env": {},
  "outputs": {
    "expect": ["results/latest.json"]
  },
  "resources": {
    "cpu": 0.3,
    "memory_mb": 128,
    "soft": {
      "proxy": 1
    }
  },
  "error_rules": {
    "resource_regex": ["429", "rate limit", "proxy", "timeout", "connection"],
    "logic_regex": ["LOGIC:"]
  },
  "heartbeat": {
    "timeout_sec": 120
  },
  "smoke": {
    "mode": "dry",
    "max_runtime_sec": 60,
    "signal_after_sec": 1.5
  },
  "runtime": {
    "user": "sched-run"
  },
  "contract_exempt": false
}
